---
import CookieBanner from '../components/CookieBanner.astro';
import { SALON } from '../data/salon';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  robots?: string;
  preloadHero?: boolean;
}

const {
  title = "Friseur Jacqueline Dickhaus — Kamp-Lintfort | Meisterbetrieb für Schnitt, Farbe & Stil",
  description = "Friseurmeisterbetrieb in Kamp-Lintfort seit 1998. Moderne Haarschnitte, Balayage, Coloration & Brautstyling für Damen, Herren & Kinder in entspannter Wohlfühlatmosphäre.",
  keywords = "Friseur Kamp-Lintfort, Haarschnitt, Coloration, Balayage, Brautfrisur, Herrenhaarschnitt, Kinderhaarschnitt, Jacqueline Dickhaus, Friseurmeisterin",
  ogImage = "/images/og-image.jpg",
  robots = "index, follow",
  preloadHero = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  name: SALON.name,
  description,
  url: canonicalUrl,
  telephone: SALON.phoneSchema,
  email: SALON.email,
  priceRange: "€€",
  paymentAccepted: "Cash, Credit Card, Girocard",
  currenciesAccepted: "EUR",
  address: {
    "@type": "PostalAddress",
    streetAddress: SALON.address.street,
    addressLocality: SALON.address.city,
    addressRegion: SALON.address.region,
    postalCode: SALON.address.postalCode,
    addressCountry: "DE",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: "51.4969",
    longitude: "6.5389",
  },
  openingHours: ["Tu-Fr 09:00-18:00", "Sa 09:00-14:00"],
  image: [
    "https://friseur-jacqueline-dickhaus.de/images/laden1-opt.webp",
    "https://friseur-jacqueline-dickhaus.de/images/laden2-opt.webp",
    "https://friseur-jacqueline-dickhaus.de/images/laden3-opt.webp",
  ],
  sameAs: [SALON.instagramUrl, SALON.googleUrl],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: SALON.rating.schemaScore,
    bestRating: "5",
    reviewCount: SALON.rating.count,
  },
  founder: {
    "@type": "Person",
    name: "Jacqueline Dickhaus",
    jobTitle: "Friseurmeisterin",
  },
  acceptsReservations: true,
};
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FAF7F4" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={SALON.name} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Geographic Meta -->
    <meta name="geo.region" content="DE-NW" />
    <meta name="geo.placename" content="Kamp-Lintfort" />
    <meta name="geo.position" content="51.4969;6.5389" />

    <!-- Open Graph -->
    <meta property="og:type" content="business.business" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SALON.name} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/images/JD_Logo_dark_RGB.png" />
    <link rel="apple-touch-icon" href="/images/JD_Logo_dark_RGB.png" />

    <!-- DSGVO-konforme EU-Fonts (Bunny Fonts) -->
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
    <link
      href="https://fonts.bunny.net/css?family=cormorant-garamond:300,400,400i,500,500i,600|plus-jakarta-sans:300,400,500,600&display=swap"
      rel="stylesheet"
    />

    {preloadHero && (
      <link rel="preload" as="image" href="/images/laden1-opt.webp" type="image/webp" fetchpriority="high" />
    )}

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  </head>
  <body class="bg-cream text-espresso font-sans antialiased overflow-x-hidden selection:bg-branding selection:text-espresso">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-espresso focus:text-cream focus:px-5 focus:py-3 focus:rounded-full focus:text-xs focus:uppercase focus:tracking-widest focus:shadow-xl"
    >
      Zum Hauptinhalt springen
    </a>
    <slot />
    <CookieBanner />

    <script>
      function initReveal() {
        const elements = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          elements.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        elements.forEach((el) => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>

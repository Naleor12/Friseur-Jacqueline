<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Live Preisverwaltung - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.bunny.net/css?family=josefin-sans:300,400,600,700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Josefin Sans', sans-serif; }
    .saving-indicator {
      animation: pulse 2s infinite;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <div id="admin-app">
    <div class="flex justify-center items-center min-h-screen">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
    </div>
  </div>

  <script>
    // @ts-nocheck
    
    // PASSWORT-SCHUTZ
    function checkPassword() {
      const savedAuth = sessionStorage.getItem('admin-authenticated');
      if (savedAuth === 'true') {
        return true; // Bereits authentifiziert in dieser Session
      }
      
      const password = prompt("🔐 Admin-Bereich\n\nBitte geben Sie das Passwort ein:");
      
      // HIER IHR PASSWORT ÄNDERN:
      const correctPassword = "friseur2024";
      
      if (password === correctPassword) {
        sessionStorage.setItem('admin-authenticated', 'true');
        return true;
      } else if (password !== null) { // Benutzer hat nicht abgebrochen
        alert("❌ Falsches Passwort!\n\nZugriff verweigert.");
      }
      
      // Zurück zur Startseite
      window.location.href = '/';
      return false;
    }
    
    // Passwort prüfen bevor Admin geladen wird
    if (!checkPassword()) {
      document.body.innerHTML = '<div style="display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;">Weiterleitung...</div>';
    }

    class LiveAdmin {
      constructor() {
        this.data = this.getInitialData();
        this.container = document.getElementById('admin-app');
        this.lastSaved = new Date();
        this.autoSaveEnabled = true;
        
        this.render();
        this.startAutoSave();
      }

      getInitialData() {
        // Versuche gespeicherte Daten zu laden, sonst Standard-Daten
        try {
          const saved = localStorage.getItem('friseur-services-data');
          if (saved) {
            return JSON.parse(saved);
          }
        } catch (error) {
          console.warn('Fehler beim Laden der Daten:', error);
        }

        // Standard-Daten
        return {
          damen: [
            {

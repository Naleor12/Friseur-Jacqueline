              highlight: false,
            },
            {
              icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z",
              title: 'Styling für Events',
              text: 'Geburtstag, Einschulung & mehr.',
              duration: '45 Min',
              price: 'ab 50€',
              highlight: false,
            },
          ],
        };
      }

      saveData() {
        try {
          localStorage.setItem('friseur-services-data', JSON.stringify(this.data));
          this.lastSaved = new Date();
          
          // Event für die Hauptseite senden
          const event = new CustomEvent('servicesDataUpdated', {
            detail: { servicesData: this.data }
          });
          window.dispatchEvent(event);
          
          // Erfolgs-Feedback
          this.showSaveIndicator();
          
        } catch (error) {
          console.error('Fehler beim Speichern:', error);
          alert('Fehler beim Speichern der Daten!');
        }
      }

      showSaveIndicator() {
        const indicator = document.getElementById('save-indicator');
        if (indicator) {
          indicator.classList.remove('hidden');
          indicator.classList.add('saving-indicator');
          setTimeout(() => {
            indicator.classList.add('hidden');
            indicator.classList.remove('saving-indicator');
          }, 2000);
        }
      }

      updateService(category, index, field, value) {
        this.data[category][index][field] = value;
        this.saveData();
      }

      startAutoSave() {
        setInterval(() => {
          if (this.autoSaveEnabled) {
            this.saveData();
          }
        }, 10000); // Auto-save alle 10 Sekunden
      }

      openPreview() {
        window.open('/', '_blank');
      }

      resetToDefaults() {
        if (confirm('Möchten Sie wirklich alle Daten auf die Standard-Werte zurücksetzen? Diese Aktion kann nicht rückgängig gemacht werden.')) {
          localStorage.removeItem('friseur-services-data');
          this.data = this.getInitialData();
          this.saveData();
          this.render();
        }
      }

      exportData() {
        const blob = new Blob([JSON.stringify(this.data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `friseur-preise-${new Date().toISOString().split('T')[0]}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      logout() {
        if (confirm('🚪 Möchten Sie sich wirklich abmelden?')) {
          sessionStorage.removeItem('admin-authenticated');
          window.location.href = '/';
        }
      }

      render() {
        this.container.innerHTML = `
          <div class="max-w-7xl mx-auto p-6">
            <!-- Header -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                  <h1 class="text-3xl font-bold text-gray-800 mb-2">🎨 Live Preisverwaltung</h1>
                  <p class="text-gray-600">Änderungen werden automatisch gespeichert und sind sofort auf der Website sichtbar</p>
                </div>
                
                <div class="flex flex-wrap gap-3">
                  <button
                    onclick="window.liveAdmin.logout()"
                    class="bg-orange-600 text-white px-4 py-2 rounded-lg hover:bg-orange-700 transition-colors flex items-center gap-2"
                  >
                    🚪 Abmelden
                  </button>
                  
                  <button
                    onclick="window.liveAdmin.openPreview()"
                    class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors flex items-center gap-2"
                  >
                    👁️ Vorschau anzeigen
                  </button>
                  
                  <button
                    onclick="window.liveAdmin.exportData()"
                    class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors flex items-center gap-2"
                  >
                    💾 Backup erstellen
                  </button>
                  
                  <button
                    onclick="window.liveAdmin.resetToDefaults()"
                    class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors flex items-center gap-2"
                  >
                    🔄 Zurücksetzen
                  </button>
                  
                  <a 
                    href="/" 
                    class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors flex items-center gap-2"
                  >
                    ← Zur Website
                  </a>
                </div>
              </div>
              
              <!-- Status Indicator -->
              <div class="mt-4 flex items-center gap-3">
                <div class="flex items-center gap-2 text-green-600">
                  <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                  <span class="text-sm font-medium">Live-Modus aktiv</span>
                </div>
                
                <div id="save-indicator" class="hidden flex items-center gap-2 text-blue-600">
                  <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                  <span class="text-sm">Wird gespeichert...</span>
                </div>
                
                <div class="text-sm text-gray-500">
                  Zuletzt gespeichert: ${this.lastSaved.toLocaleTimeString('de-DE')}
                </div>
              </div>
            </div>

            <!-- Service Editor -->
            ${Object.entries(this.data).map(([category, services]) => `
              <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
                <h2 class="text-2xl font-bold text-gray-800 mb-6 capitalize flex items-center gap-3">
                  <span class="bg-gradient-to-r from-blue-500 to-purple-600 text-white px-4 py-2 rounded-full text-lg">
                    ${services.length} Services
                  </span>
                  ${category === 'damen' ? '👩 Damen' : category === 'herren' ? '👨 Herren' : '👶 Kids'}
                </h2>
                
                <div class="grid gap-6">
                  ${services.map((service, index) => `
                    <div class="border-2 border-gray-200 rounded-xl p-6 hover:border-blue-300 transition-all duration-200 ${service.highlight ? 'bg-yellow-50 border-yellow-300' : ''}">
                      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 mb-4">
                        <div>
                          <label class="block text-sm font-semibold text-gray-700 mb-2">Titel</label>
                          <input
                            type="text"
                            value="${service.title}"
                            oninput="window.liveAdmin.updateService('${category}', ${index}, 'title', this.value)"
                            class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 transition-colors"
                          />
                        </div>
                        
                        <div>
                          <label class="block text-sm font-semibold text-gray-700 mb-2">Dauer</label>
                          <input
                            type="text"
                            value="${service.duration}"
                            oninput="window.liveAdmin.updateService('${category}', ${index}, 'duration', this.value)"
                            class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 transition-colors"
                          />
                        </div>
                        
                        <div>
                          <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <span class="flex items-center gap-2">
                              💰 Preis
                              <span class="bg-yellow-200 text-yellow-800 px-2 py-1 rounded-full text-xs font-bold">LIVE</span>
                            </span>
                          </label>
                          <input
                            type="text"
                            value="${service.price}"
                            oninput="window.liveAdmin.updateService('${category}', ${index}, 'price', this.value)"
                            class="w-full border-2 border-yellow-400 rounded-lg px-4 py-3 focus:outline-none focus:border-yellow-600 bg-yellow-50 font-semibold text-yellow-900 transition-colors"
                          />
                        </div>
                        
                        <div class="flex items-end">
                          <label class="flex items-center space-x-3 cursor-pointer p-2 rounded-lg hover:bg-gray-50">
                            <input
                              type="checkbox"
                              ${service.highlight ? 'checked' : ''}
                              onchange="window.liveAdmin.updateService('${category}', ${index}, 'highlight', this.checked)"
                              class="w-5 h-5 rounded border-2 border-gray-300 text-blue-600 focus:ring-blue-500"
                            />
                            <span class="text-sm font-semibold text-gray-700">⭐ Beliebt</span>
                          </label>
                        </div>
                      </div>
                      
                      <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Beschreibung</label>
                        <textarea
                          rows="3"
                          oninput="window.liveAdmin.updateService('${category}', ${index}, 'text', this.value)"
                          class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 transition-colors resize-none"
                        >${service.text}</textarea>
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>
            `).join('')}

            <!-- Footer -->
            <div class="bg-gradient-to-r from-gray-800 to-gray-900 text-white rounded-xl p-6 text-center">
              <p class="text-lg font-semibold mb-2">🚀 Live-Verwaltung aktiv</p>
              <p class="text-gray-300">Alle Änderungen werden automatisch gespeichert und sind sofort auf der Website sichtbar.</p>
              <p class="text-sm text-gray-400 mt-2">Zuletzt aktualisiert: ${new Date().toLocaleString('de-DE')}</p>
            </div>
          </div>
        `;
      }
    }

    // Live-Admin initialisieren
    window.liveAdmin = new LiveAdmin();
  </script>
</body>
</html>
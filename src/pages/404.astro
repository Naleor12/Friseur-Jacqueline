---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SALON } from '../data/salon';
---

<BaseLayout
  title="Seite nicht gefunden — Friseur Jacqueline Dickhaus"
  description="Die angeforderte Seite wurde leider nicht gefunden."
  robots="noindex, nofollow"
>
  <Navbar isSubpage={true} />

  <main id="main-content" class="min-h-[75vh] bg-cream pt-36 pb-24 flex items-center">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 text-center space-y-8">
      <p class="text-[11px] uppercase tracking-editorial text-branding-700 font-medium">
        Fehler 404
      </p>
      <h1 class="font-serif text-5xl sm:text-6xl text-espresso font-normal leading-tight">
        Diese Seite gibt es <em class="italic font-light text-branding-700">leider nicht.</em>
      </h1>
      <p class="text-ink font-light text-base sm:text-lg leading-relaxed max-w-lg mx-auto">
        Vielleicht hat sich ein Link geändert oder die Adresse enthält einen Tippfehler.
        Auf unserer Startseite findest du alle Leistungen, Preise und Öffnungszeiten.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 bg-espresso text-cream px-7 py-4 rounded-full text-xs uppercase tracking-[0.15em] font-medium hover:bg-bark transition-colors"
        >
          <span>Zur Startseite</span>
        </a>
        <a
          href={SALON.phoneHref}
          class="inline-flex items-center gap-2.5 border border-espresso/25 text-espresso px-7 py-4 rounded-full text-xs uppercase tracking-[0.15em] font-medium hover:border-espresso hover:bg-sand transition-colors"
        >
          <span>Anrufen: {SALON.phoneDisplay}</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

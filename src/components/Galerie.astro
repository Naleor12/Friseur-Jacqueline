---
import { SALON } from '../data/salon';

const galleryItems = [
  {
    src: "/images/laden1-opt.webp",
    title: "Unser Salon in Kamp-Lintfort",
    subtitle: "Warme Holzlamellen, runde Spiegel & ruhiges Licht",
    category: "salon",
    span: "md:col-span-2 aspect-[16/10]",
  },
  {
    src: "/images/blond-opt.webp",
    title: "Sonnengeküsstes Balayage",
    subtitle: "Weiche Übergänge & natürliche Wellen",
    category: "work",
    span: "aspect-[4/5] md:aspect-auto",
  },
  {
    src: "/images/braut-opt.webp",
    title: "Braut- & Anlassstyling",
    subtitle: "Romantische Flecht- & Steckfrisur mit Schleierkraut",
    category: "work",
    span: "aspect-[4/5]",
  },
  {
    src: "/images/laden2-opt.webp",
    title: "Die Lounge",
    subtitle: "Ankommen, durchatmen & den Alltag vergessen",
    category: "salon",
    span: "aspect-[4/5]",
  },
  {
    src: "/images/styling-opt.webp",
    title: "Präzises Styling & Finish",
    subtitle: "Geschmeidige Bewegung & natürlicher Glanz",
    category: "work",
    span: "aspect-[4/5]",
  },
  {
    src: "/images/laden3-opt.webp",
    title: "Empfang & Ambiente",
    subtitle: "Boutique-Charakter mit Liebe zum Detail",
    category: "salon",
    span: "md:col-span-2 aspect-[16/10]",
  },
  {
    src: "/images/schnitt-opt.webp",
    title: "Moderne Schnittkunst",
    subtitle: "Typgerechter Bob mit klarer Linie",
    category: "work",
    span: "aspect-[4/5] md:aspect-auto",
  },
];
---

<section id="galerie" class="scroll-mt-20 bg-cream py-24 lg:py-32">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-14">
    <!-- Header & Filters -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-14 reveal">
      <div class="space-y-4">
        <p class="text-[11px] uppercase tracking-editorial text-branding-700 font-medium">
          04 — Galerie
        </p>
        <h2 class="font-serif text-4xl sm:text-5xl xl:text-[3.5rem] text-espresso font-normal leading-tight">
          Einblicke &amp; <em class="italic font-light text-branding-700">Arbeiten</em>
        </h2>
      </div>

      <!-- Minimal Filter Buttons -->
      <div class="flex items-center gap-2" role="group" aria-label="Galerie filtern">
        <button
          type="button"
          data-filter="all"
          class="gallery-filter is-active px-5 py-2.5 rounded-full text-xs uppercase tracking-[0.14em] font-medium transition-all duration-300 bg-espresso text-cream"
        >
          Alle
        </button>
        <button
          type="button"
          data-filter="salon"
          class="gallery-filter px-5 py-2.5 rounded-full text-xs uppercase tracking-[0.14em] font-medium transition-all duration-300 bg-sand text-ink hover:text-espresso"
        >
          Salon
        </button>
        <button
          type="button"
          data-filter="work"
          class="gallery-filter px-5 py-2.5 rounded-full text-xs uppercase tracking-[0.14em] font-medium transition-all duration-300 bg-sand text-ink hover:text-espresso"
        >
          Arbeiten
        </button>
      </div>
    </div>

    <!-- Curated Bento Grid -->
    <div id="gallery-grid" class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 reveal reveal-delay-1">
      {galleryItems.map((item, idx) => (
        <figure
          data-category={item.category}
          data-index={idx}
          data-src={item.src}
          data-title={item.title}
          data-subtitle={item.subtitle}
          class={`gallery-card group relative overflow-hidden rounded-[1.5rem] bg-sand cursor-pointer ${item.span}`}
          tabindex="0"
          role="button"
          aria-label={`Bild vergrößern: ${item.title}`}
        >
          <img
            src={item.src}
            alt={`${item.title} – ${item.subtitle}`}
            class="w-full h-full object-cover object-center transition-transform duration-700 ease-editorial group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-espresso/80 via-espresso/15 to-transparent opacity-80 sm:opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-400 flex items-end p-6">
            <div class="transform sm:translate-y-2 group-hover:translate-y-0 transition-transform duration-400">
              <p class="font-serif text-2xl text-cream font-normal leading-snug">{item.title}</p>
              <p class="text-xs text-cream/80 font-light mt-1">{item.subtitle}</p>
            </div>
          </div>
        </figure>
      ))}
    </div>

    <!-- Instagram Strip -->
    <div class="mt-14 pt-10 border-t border-linen flex flex-col sm:flex-row items-center justify-between gap-4 reveal">
      <p class="text-sm text-ink font-light">
        Tägliche Inspiration, Vorher-Nachher-Looks &amp; Einblicke aus dem Salon-Alltag.
      </p>
      <a
        href={SALON.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 text-xs uppercase tracking-[0.15em] font-medium text-espresso hover:text-branding-700 transition-colors"
      >
        <svg class="w-4 h-4 text-branding-700" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm5.25-.75a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z" />
        </svg>
        <span>{SALON.instagramHandle}</span>
        <span class="w-6 h-px bg-espresso group-hover:bg-branding-700 group-hover:w-10 transition-all duration-300"></span>
      </a>
    </div>
  </div>

  <!-- Fullscreen Editorial Lightbox -->
  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-[70] hidden items-center justify-center bg-espresso/95 backdrop-blur-md p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Bildansicht"
  >
    <button
      id="lb-close"
      type="button"
      class="absolute top-5 right-5 sm:top-8 sm:right-8 w-11 h-11 rounded-full border border-white/20 text-cream hover:border-branding hover:text-branding flex items-center justify-center transition-colors"
      aria-label="Schließen"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <button
      id="lb-prev"
      type="button"
      class="absolute left-3 sm:left-8 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full border border-white/20 text-cream hover:border-branding hover:text-branding flex items-center justify-center transition-colors"
      aria-label="Vorheriges Bild"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <button
      id="lb-next"
      type="button"
      class="absolute right-3 sm:right-8 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full border border-white/20 text-cream hover:border-branding hover:text-branding flex items-center justify-center transition-colors"
      aria-label="Nächstes Bild"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <div class="max-w-5xl w-full flex flex-col items-center gap-5">
      <img
        id="lb-img"
        src=""
        alt=""
        class="max-h-[75vh] w-auto max-w-full object-contain rounded-xl shadow-2xl"
      />
      <div class="w-full max-w-2xl flex items-end justify-between gap-4 text-cream px-2">
        <div>
          <p id="lb-title" class="font-serif text-2xl sm:text-3xl font-normal"></p>
          <p id="lb-subtitle" class="text-xs sm:text-sm text-cream/70 font-light mt-1"></p>
        </div>
        <span id="lb-counter" class="text-xs uppercase tracking-editorial text-branding flex-shrink-0"></span>
      </div>
    </div>
  </div>
</section>

<script>
  function initGallery() {
    const filters = document.querySelectorAll('.gallery-filter');
    const cards = Array.from(document.querySelectorAll('.gallery-card')) as HTMLElement[];
    const lightbox = document.getElementById('gallery-lightbox');
    const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
    const lbTitle = document.getElementById('lb-title');
    const lbSubtitle = document.getElementById('lb-subtitle');
    const lbCounter = document.getElementById('lb-counter');
    const lbClose = document.getElementById('lb-close');
    const lbPrev = document.getElementById('lb-prev');
    const lbNext = document.getElementById('lb-next');

    let visibleCards: HTMLElement[] = [...cards];
    let currentIdx = 0;

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = (btn as HTMLElement).dataset.filter || 'all';
        filters.forEach((b) => {
          b.classList.remove('bg-espresso', 'text-cream', 'is-active');
          b.classList.add('bg-sand', 'text-ink');
        });
        btn.classList.add('bg-espresso', 'text-cream', 'is-active');
        btn.classList.remove('bg-sand', 'text-ink');

        visibleCards = [];
        cards.forEach((card) => {
          const match = filter === 'all' || card.dataset.category === filter;
          card.style.display = match ? '' : 'none';
          if (match) visibleCards.push(card);
        });
      });
    });

    const renderLightbox = () => {
      const card = visibleCards[currentIdx];
      if (!card || !lbImg) return;
      lbImg.src = card.dataset.src || '';
      lbImg.alt = card.dataset.title || '';
      if (lbTitle) lbTitle.textContent = card.dataset.title || '';
      if (lbSubtitle) lbSubtitle.textContent = card.dataset.subtitle || '';
      if (lbCounter) {
        const num = String(currentIdx + 1).padStart(2, '0');
        const total = String(visibleCards.length).padStart(2, '0');
        lbCounter.textContent = `${num} / ${total}`;
      }
    };

    const openLightbox = (card: HTMLElement) => {
      currentIdx = Math.max(0, visibleCards.indexOf(card));
      renderLightbox();
      lightbox?.classList.remove('hidden');
      lightbox?.classList.add('flex');
      document.body.classList.add('modal-open');
    };

    const closeLightbox = () => {
      lightbox?.classList.add('hidden');
      lightbox?.classList.remove('flex');
      document.body.classList.remove('modal-open');
    };

    const step = (dir: number) => {
      if (!visibleCards.length) return;
      currentIdx = (currentIdx + dir + visibleCards.length) % visibleCards.length;
      renderLightbox();
    };

    cards.forEach((card) => {
      card.addEventListener('click', () => openLightbox(card));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(card);
        }
      });
    });

    lbClose?.addEventListener('click', closeLightbox);
    lbPrev?.addEventListener('click', () => step(-1));
    lbNext?.addEventListener('click', () => step(1));

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox?.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallery);
  } else {
    initGallery();
  }
</script>

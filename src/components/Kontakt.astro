---
---

<section id="kontakt" class="scroll-mt-24 relative bg-white py-32 px-4 overflow-hidden">
  <!-- Subtle Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-20 left-10 w-96 h-96 bg-branding rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-72 h-72 bg-gray-300 rounded-full blur-3xl"></div>
  </div>
  
  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Header -->
    <div class="text-center mb-20" data-aos="fade-up">
      <div class="inline-flex items-center gap-4 mb-6 px-6 py-3 bg-branding/5 rounded-full">
        <div class="w-6 h-px bg-branding"></div>
        <span class="text-branding font-medium text-sm uppercase tracking-wider">Kontakt</span>
        <div class="w-6 h-px bg-branding"></div>
      </div>
      <h2 class="text-4xl lg:text-5xl font-bold font-josefin text-gray-900 mb-4">
        Bereit für deinen
        <span class="text-branding block">neuen Look?</span>
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Vereinbare jetzt deinen Termin oder komm spontan vorbei – wir freuen uns auf dich!
      </p>
    </div>

    <!-- Split Layout -->
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      
      <!-- Left Side - Contact Cards -->
      <div class="space-y-6" data-aos="fade-right">
        
        <!-- Address Card -->
        <div class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 hover:-translate-y-1">
          <div class="flex items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-branding/10 rounded-xl flex items-center justify-center group-hover:bg-branding/20 transition-colors duration-300">
                <svg class="w-7 h-7 text-branding" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold text-gray-900 mb-2 font-josefin">Besuche uns</h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                Wiesenbruchstraße 39<br>
                47475 Kamp-Lintfort
              </p>
              <a 
                href="https://maps.google.com?q=Wiesenbruchstraße+39,+47475+Kamp-Lintfort"
                target="_blank"
                class="inline-flex items-center gap-2 text-branding hover:text-branding-600 transition-colors font-medium"
              >
                <span>Route planen</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Phone Card -->
        <div class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 hover:-translate-y-1">
          <div class="flex items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-branding/10 rounded-xl flex items-center justify-center group-hover:bg-branding/20 transition-colors duration-300">
                <svg class="w-7 h-7 text-branding" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold text-gray-900 mb-2 font-josefin">Ruf uns an</h3>
              <p class="text-gray-600 mb-4">Für Terminvereinbarungen und Fragen</p>
              <a 
                href="tel:+4928421219526"
                class="inline-flex items-center gap-2 text-branding hover:text-branding-600 transition-colors font-medium text-lg"
              >
                <span>02842 1219526</span>
                <svg class="w-4 h-4 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Email Card -->
        <div class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 hover:-translate-y-1">
          <div class="flex items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-branding/10 rounded-xl flex items-center justify-center group-hover:bg-branding/20 transition-colors duration-300">
                <svg class="w-7 h-7 text-branding" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold text-gray-900 mb-2 font-josefin">Schreib uns</h3>
              <p class="text-gray-600 mb-4">Für Anfragen und Informationen</p>
              <a 
                href="mailto:info@friseur-jacqueline-dickhaus.de"
                class="inline-flex items-center gap-2 text-branding hover:text-branding-600 transition-colors font-medium"
              >
                <span>info@friseur-jacqueline-dickhaus.de</span>
                <svg class="w-4 h-4 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Right Side - Opening Hours & CTA -->
      <div class="space-y-8" data-aos="fade-left">
        
        <!-- Opening Hours Card -->
        <div class="bg-gradient-to-br from-branding/5 to-branding/10 rounded-2xl p-8 border border-branding/20">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-branding/20 rounded-xl flex items-center justify-center">
              <svg class="w-6 h-6 text-branding" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 font-josefin">Öffnungszeiten</h3>
          </div>
          
          <div class="space-y-4">
            <div class="flex justify-between items-center py-2 border-b border-branding/10">
              <span class="font-medium text-gray-700">Montag</span>
              <span class="text-gray-500">Geschlossen</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-branding/10">
              <span class="font-medium text-gray-700">Dienstag - Freitag</span>
              <span class="text-gray-900 font-medium">09:00 - 18:00</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="font-medium text-gray-700">Samstag</span>
              <span class="text-gray-900 font-medium">09:00 - 14:00</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="font-medium text-gray-700">Sonntag</span>
              <span class="text-gray-500">Geschlossen</span>
            </div>
          </div>
        </div>

        <!-- CTA Section -->
        <div class="text-center space-y-6">
          <h3 class="text-2xl font-bold text-gray-900 font-josefin">Bereit für deinen Termin?</h3>
          <p class="text-gray-600">Ruf uns an oder folge uns auf Instagram für Inspiration!</p>
          
          <div class="space-y-4">
            <a 
              href="tel:+4928421219526"
              class="block w-full bg-branding text-white py-5 px-8 rounded-xl font-medium text-lg hover:bg-branding-600 transition-all duration-300 hover:scale-105 hover:shadow-lg group"
            >
              <div class="flex items-center justify-center gap-3">
                <svg class="w-6 h-6 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>Anrufen: 02842 1219526</span>
              </div>
            </a>
            <a 
              href="https://www.instagram.com/friseur_jacqueline_dickhaus?igsh=MWF4OWJua3hmdTBhaw=="
              target="_blank"
              class="block w-full bg-branding text-white py-5 px-8 rounded-xl font-medium text-lg hover:bg-branding-600 transition-all duration-300 hover:scale-105 hover:shadow-lg group"
            >
              <div class="flex items-center justify-center gap-3">
                <svg class="w-6 h-6 transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm5.25-.75a .75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z" />
                </svg>
                <span>Folge uns: @friseur_jacqueline</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Social Media -->
        <div class="text-center pt-8 border-t border-gray-200">
          <p class="text-gray-600 mb-4">Folge uns auf Instagram</p>
          <a 
            href="https://www.instagram.com/friseur_jacqueline_dickhaus?igsh=MWF4OWJua3hmdTBhaw=="
            target="_blank"
            class="inline-flex items-center gap-3 text-gray-600 hover:text-branding transition-colors group"
          >
            <svg class="w-6 h-6 transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
              <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm5.25-.75a .75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z" />
            </svg>
            <span class="font-medium">@friseur_jacqueline_dickhaus</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
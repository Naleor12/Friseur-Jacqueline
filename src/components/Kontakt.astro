---
import { SALON } from '../data/salon';
---

<section id="kontakt" class="scroll-mt-20 bg-sand py-24 lg:py-32 border-t border-linen">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-14">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left: Invitation & Direct Contact -->
      <div class="lg:col-span-6 space-y-10 reveal">
        <div class="space-y-4">
          <p class="text-[11px] uppercase tracking-editorial text-branding-700 font-medium">
            07 — Kontakt &amp; Anfahrt
          </p>
          <h2 class="font-serif text-4xl sm:text-5xl xl:text-[3.5rem] text-espresso font-normal leading-tight">
            Wir freuen uns <em class="italic font-light text-branding-700">auf dich.</em>
          </h2>
          <p class="text-ink font-light text-base sm:text-[17px] leading-relaxed max-w-lg">
            Vereinbare deinen Wunschtermin am besten telefonisch – so finden wir direkt das
            passende Zeitfenster für deinen Schnitt, deine Farbe oder dein Styling.
          </p>
        </div>

        <!-- Primary Phone Callout -->
        <div class="space-y-2 pb-8 border-b border-linen">
          <p class="text-[11px] uppercase tracking-editorial text-taupe">Telefonische Terminvergabe</p>
          <a
            href={SALON.phoneHref}
            class="inline-block font-serif text-4xl sm:text-5xl text-espresso hover:text-branding-700 transition-colors"
          >
            {SALON.phoneDisplay}
          </a>
        </div>

        <!-- Address & Email Grid -->
        <div class="grid sm:grid-cols-2 gap-8">
          <div class="space-y-2">
            <p class="text-[11px] uppercase tracking-editorial text-taupe">Adresse</p>
            <p class="text-espresso font-medium leading-relaxed">
              {SALON.address.street}<br />
              {SALON.address.postalCode} {SALON.address.city}
            </p>
            <a
              href={SALON.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.14em] text-branding-700 hover:text-espresso transition-colors font-medium pt-1"
            >
              <span>Route in Google Maps</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          <div class="space-y-2">
            <p class="text-[11px] uppercase tracking-editorial text-taupe">E-Mail &amp; Social</p>
            <a
              href={`mailto:${SALON.email}`}
              class="block text-espresso hover:text-branding-700 transition-colors text-sm font-medium break-all"
            >
              {SALON.email}
            </a>
            <a
              href={SALON.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.14em] text-branding-700 hover:text-espresso transition-colors font-medium pt-1"
            >
              <span>Instagram: {SALON.instagramHandle}</span>
            </a>
          </div>
        </div>

        <!-- Primary Action Buttons -->
        <div class="flex flex-wrap gap-3.5 pt-2">
          <a
            href={SALON.phoneHref}
            class="inline-flex items-center gap-2.5 bg-espresso text-cream px-7 py-4 rounded-full text-xs uppercase tracking-[0.15em] font-medium hover:bg-bark transition-all duration-300 hover:shadow-md"
          >
            <svg class="w-4 h-4 text-branding" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Jetzt anrufen</span>
          </a>
          <a
            href={SALON.mapsSearchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 border border-espresso/25 text-espresso px-7 py-4 rounded-full text-xs uppercase tracking-[0.15em] font-medium hover:border-espresso hover:bg-cream transition-colors"
          >
            <span>Anfahrt planen</span>
          </a>
        </div>
      </div>

      <!-- Right: 2-Click DSGVO Map / Salon Banner + Atelier Opening Hours Card -->
      <div class="lg:col-span-6 reveal reveal-delay-1">
        <div class="bg-cream rounded-[2rem] border border-linen overflow-hidden shadow-sm">
          <!-- 2-Click DSGVO Interactive Map Container -->
          <div id="map-container" class="relative h-56 sm:h-64 bg-espresso overflow-hidden">
            <img
              src="/images/laden3-opt.webp"
              alt="Eingangs- und Lounge-Bereich bei Friseur Jacqueline Dickhaus in Kamp-Lintfort"
              width="1600"
              height="1001"
              decoding="async"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-espresso/85 via-espresso/40 to-espresso/20"></div>
            <div class="absolute inset-0 p-6 sm:p-7 flex flex-col justify-between text-cream">
              <div class="flex items-center justify-between gap-4">
                <span class="text-[10px] uppercase tracking-editorial bg-espresso/70 backdrop-blur-sm border border-white/15 px-3 py-1 rounded-full text-branding">
                  Anfahrt · Kamp-Lintfort
                </span>
                <a
                  href={SALON.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[11px] uppercase tracking-wider text-cream/85 hover:text-branding transition-colors"
                >
                  In Maps öffnen ↗
                </a>
              </div>

              <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
                <div>
                  <p class="font-serif text-2xl sm:text-3xl font-normal leading-tight">
                    {SALON.address.street}
                  </p>
                  <p class="text-xs text-cream/75 font-light mt-0.5">
                    {SALON.address.postalCode} {SALON.address.city}
                  </p>
                </div>
                <button
                  id="load-map-btn"
                  type="button"
                  class="self-start sm:self-auto inline-flex items-center gap-2 bg-cream/95 text-espresso hover:bg-branding text-[11px] uppercase tracking-[0.14em] font-semibold px-4 py-2.5 rounded-full transition-colors shadow-lg"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>Karte laden</span>
                </button>
              </div>
            </div>
          </div>

          <div class="p-7 sm:p-10">
            <div class="flex flex-wrap items-center justify-between gap-4 pb-5 border-b border-linen">
              <div>
                <p class="text-[11px] uppercase tracking-editorial text-taupe">Salon-Zeiten</p>
                <h3 class="font-serif text-3xl text-espresso font-normal mt-0.5">Öffnungszeiten</h3>
              </div>
              <span
                id="contact-open-badge"
                class="inline-flex items-center gap-2 text-xs font-medium px-3.5 py-1.5 rounded-full bg-sand text-ink border border-linen"
              >
                Di–Sa geöffnet
              </span>
            </div>

            <dl class="divide-y divide-linen/80 mt-2">
              {SALON.hours.map((row) => (
                <div class="flex items-center justify-between py-3.5 text-sm sm:text-base">
                  <dt class={row.closed ? "text-taupe font-light" : "text-espresso font-medium"}>
                    {row.day}
                  </dt>
                  <dd class={row.closed ? "text-taupe font-light" : "text-espresso tabular-nums"}>
                    {row.time}
                  </dd>
                </div>
              ))}
            </dl>

            <div class="mt-6 pt-5 border-t border-linen flex items-start gap-3 text-xs text-ink font-light leading-relaxed">
              <svg class="w-4 h-4 text-branding-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p>
                Mit Klick auf „Karte laden“ wird Google Maps extern eingebunden (DSGVO-2-Klick-Schutz).
                Alternativ kannst du die Route direkt in der Google-Maps-App öffnen.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initTwoClickMap() {
    const btn = document.getElementById('load-map-btn');
    const container = document.getElementById('map-container');
    if (!btn || !container) return;

    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.title = 'Standort Friseur Jacqueline Dickhaus — Wiesenbruchstraße 39, 47475 Kamp-Lintfort';
      iframe.src = 'https://www.google.com/maps?q=Wiesenbruchstra%C3%9Fe+39,+47475+Kamp-Lintfort&output=embed';
      iframe.className = 'w-full h-full border-0';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      container.innerHTML = '';
      container.appendChild(iframe);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTwoClickMap);
  } else {
    initTwoClickMap();
  }
</script>

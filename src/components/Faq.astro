---
import { SALON } from '../data/salon';

const faqs = [
  {
    q: "Wie vereinbare ich am besten einen Termin?",
    a: `Am schnellsten erreichst du uns telefonisch unter ${SALON.phoneDisplay}. Im kurzen Gespräch klären wir direkt deine Wünsche – besonders bei Balayage, Farbveränderungen oder Hochsteckfrisuren – damit wir ausreichend Zeit für dich einplanen können.`,
  },
  {
    q: "Kann ich auch spontan ohne Termin vorbeikommen?",
    a: "Wir empfehlen eine vorherige telefonische Terminabsprache, damit du ohne Wartezeit drankommst. Für spontane Schnitte schauen wir aber gern kurzfristig, ob am selben Tag noch eine freie Lücke entsteht – ein kurzer Anruf genügt.",
  },
  {
    q: "Wovon hängen die „ab“-Preise bei Farbe & Balayage ab?",
    a: "Jedes Haar ist individuell. Je nach Haarlänge, Haardichte und gewünschter Farbtechnik variieren Zeit- und Materialaufwand. Vor jeder Behandlung besprechen wir dein Wunschziel ehrlich und transparent – inklusive einer klaren Preiseinschätzung.",
  },
  {
    q: "Wie läuft ein Braut- oder Anlassstyling ab?",
    a: "Bei unseren Hochsteck- und Brautfrisuren ist ein ausführlicher Probetermin bereits inklusive. Gemeinsam testen wir Stil, Haarschmuck und Haltbarkeit in Ruhe vorab, damit du an deinem großen Tag entspannt strahlen kannst.",
  },
  {
    q: "Welche Zahlungsmöglichkeiten gibt es im Salon?",
    a: "Du kannst bei uns ganz bequem in bar sowie per Girocard (EC-Karte) oder Kreditkarte bezahlen.",
  },
];
---

<section id="faq" class="scroll-mt-20 bg-cream py-24 lg:py-32 border-t border-linen">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-14">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left: Intro & Direct Phone Consultation Card -->
      <div class="lg:col-span-5 space-y-8 reveal">
        <div class="space-y-4">
          <p class="text-[11px] uppercase tracking-editorial text-branding-700 font-medium">
            06 — Gut zu wissen
          </p>
          <h2 class="font-serif text-4xl sm:text-5xl text-espresso font-normal leading-tight">
            Häufige <em class="italic font-light text-branding-700">Fragen</em>
          </h2>
          <p class="text-ink font-light text-sm sm:text-base leading-relaxed">
            Alles Wichtige rund um deinen Besuch bei uns in Kamp-Lintfort – transparent,
            unkompliziert und auf einen Blick.
          </p>
        </div>

        <!-- Direkter Kontakt / Persönliche Rückfrage -->
        <div class="rounded-[1.75rem] bg-espresso text-cream p-7 sm:p-8 border border-white/10 space-y-4 shadow-lg">
          <div class="flex items-center justify-between gap-4">
            <span class="text-[10px] uppercase tracking-editorial text-branding font-medium">
              Direkter Draht
            </span>
            <img src="/images/JD_Logo_light_RGB.svg" alt="" aria-hidden="true" class="h-6 w-auto opacity-80" />
          </div>
          <h3 class="font-serif text-3xl font-normal leading-snug">
            Deine Frage war <em class="italic text-branding font-light">nicht dabei?</em>
          </h3>
          <p class="text-sm text-cream/75 font-light leading-relaxed">
            Du planst eine größere Farbveränderung, ein Event-Styling oder hast eine spezielle
            Frage zu deinem Haar? Ruf uns einfach kurz im Salon an – wir helfen dir gern weiter.
          </p>
          <div class="pt-1">
            <a
              href={SALON.phoneHref}
              class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-branding hover:text-cream transition-colors font-medium"
            >
              <span>Anrufen: {SALON.phoneDisplay}</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Accessible Editorial Accordion -->
      <div class="lg:col-span-7 divide-y divide-linen border-t border-b border-linen reveal reveal-delay-1">
        {faqs.map((item, idx) => (
          <details class="faq-item group py-6" open={idx === 0}>
            <summary class="flex items-center justify-between gap-6 cursor-pointer list-none select-none">
              <span class="font-serif text-2xl sm:text-[26px] text-espresso group-hover:text-branding-700 transition-colors leading-snug">
                {item.q}
              </span>
              <span
                class="w-9 h-9 rounded-full border border-linen flex items-center justify-center flex-shrink-0 text-espresso group-hover:border-branding-500 transition-all duration-300"
                aria-hidden="true"
              >
                <svg class="faq-icon w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 pr-12 text-sm sm:text-base text-ink font-light leading-relaxed">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
</style>

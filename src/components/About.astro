---
import TeamCard from './TeamCard.astro';
---

<section
  id="ueber-uns"
  class="scroll-mt-24 relative min-h-screen bg-white overflow-hidden"
>
  <!-- Split Screen Container -->
  <div class="grid lg:grid-cols-2 min-h-screen">
    <!-- Left Side - Hero Image with Parallax -->
    <div class="relative overflow-hidden bg-gray-900">
      <div
        id="about-parallax-bg"
        class="absolute inset-0 bg-cover bg-center bg-no-repeat scale-110 transition-transform duration-700"
        style="background-image: url('/images/ladenbw.JPG');"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-br from-black/40 via-black/20 to-black/60"></div>
      <div class="absolute bottom-12 left-8 right-8 text-center">
        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20">
          <blockquote class="text-white text-lg font-light italic leading-relaxed">
            „Schönheit beginnt in dem Moment, in dem du beschließt, du selbst zu sein."
          </blockquote>
          <p class="text-branding font-medium mt-2">— Jacqueline</p>
        </div>
      </div>
    </div>

    <!-- Right Side - Content -->
    <div class="relative flex flex-col justify-center px-8 lg:px-16 py-16 lg:py-24">
      <div class="absolute inset-0 opacity-5">
        <div class="absolute top-0 right-0 w-64 h-64 bg-branding rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-gray-200 rounded-full blur-2xl"></div>
      </div>
      <div class="relative z-10 max-w-xl">
        <div class="mb-12" data-aos="fade-left" data-aos-delay="200">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-8 h-px bg-branding"></div>
            <span class="text-branding font-medium text-sm uppercase tracking-wider">Über uns</span>
          </div>
          <h2 class="text-4xl lg:text-5xl font-bold font-josefin text-gray-900 leading-tight">
            Mehr als nur ein
            <span class="text-branding block">Friseur-Salon</span>
          </h2>
        </div>
        <div class="space-y-8">
          <div data-aos="fade-left" data-aos-delay="400">
            <h3 class="text-xl font-semibold text-gray-800 mb-4 font-josefin">Unsere Mission</h3>
            <p class="text-gray-600 leading-relaxed font-josefin">
              Bei Jacqueline Dickhaus dreht sich alles um Stil, Persönlichkeit und echte Handwerkskunst.
              Unser Team aus erfahrenen Friseuren und Stylisten nimmt sich Zeit für deine Wünsche – mit
              individueller Beratung, modernen Techniken und viel Liebe zum Detail.
            </p>
          </div>
          <div data-aos="fade-left" data-aos-delay="600">
            <h3 class="text-xl font-semibold text-gray-800 mb-4 font-josefin">Was uns auszeichnet</h3>
            <p class="text-gray-600 leading-relaxed font-josefin">
              Ob klassischer Schnitt, trendige Farbe oder besondere Anlässe: Wir kreieren Looks,
              die zu dir passen und dich strahlen lassen. In entspannter Atmosphäre, mit hochwertigen
              Produkten und echtem Wohlfühlfaktor.
            </p>
          </div>
          <div class="grid grid-cols-3 gap-6 py-8" data-aos="fade-left" data-aos-delay="800">
            <div class="text-center">
              <div class="text-2xl font-bold text-branding font-josefin">Qualität</div>
              <div class="text-sm text-gray-500 font-josefin">Meisterbetrieb</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-branding font-josefin">25+</div>
              <div class="text-sm text-gray-500 font-josefin">Jahre Erfahrung</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-branding font-josefin">Herz</div>
              <div class="text-sm text-gray-500 font-josefin">für jeden Kunden</div>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-4" data-aos="fade-left" data-aos-delay="1000">
            <a
              href="tel:+4928421219526"
              class="group inline-flex items-center justify-center bg-branding text-white px-6 py-3 rounded-full font-medium text-base transition-all duration-300 hover:bg-branding-600 hover:scale-105 hover:shadow-2xl"
            >
              <svg class="w-5 h-5 mr-2 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span>Anrufen: 02842 1219526</span>
            </a>
            <a
              href="https://www.instagram.com/friseur_jacqueline_dickhaus?igsh=MWF4OWJua3hmdTBhaw=="
              target="_blank"
              class="group inline-flex items-center justify-center bg-branding text-white px-6 py-3 rounded-full font-medium text-base transition-all duration-300 hover:bg-branding-600 hover:scale-105 hover:shadow-2xl"
            >
              <svg class="w-5 h-5 mr-2 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm5.25-.75a .75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z" />
              </svg>
              <span>Folge uns: @friseur_jacqueline</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Team Section -->
  <div class="relative bg-white py-32 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 right-10 w-72 h-72 bg-branding rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 left-10 w-96 h-96 bg-gray-300 rounded-full blur-3xl"></div>
    </div>
    <div class="max-w-6xl mx-auto relative z-10">
      <div class="text-center mb-20" data-aos="fade-up">
        <div class="inline-flex items-center gap-4 mb-6 px-6 py-3 bg-branding/5 rounded-full">
          <div class="w-6 h-px bg-branding"></div>
          <span class="text-branding font-medium text-sm uppercase tracking-wider">Unser Team</span>
          <div class="w-6 h-px bg-branding"></div>
        </div>
        <h2 class="text-4xl lg:text-5xl font-bold font-josefin text-gray-900 mb-4">
          Die Menschen hinter
          <span class="text-branding block">dem perfekten Look</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Ein eingespieltes Team mit einer gemeinsamen Vision: Dir den Look zu verleihen, der deine Persönlichkeit zum Strahlen bringt.
        </p>
        <p class="text-sm text-gray-400 mt-4 hidden md:block">Hover über die Karten für mehr Details</p>
        <p class="text-sm text-gray-400 mt-4 md:hidden">Tippe auf "Mehr erfahren" für Details</p>
      </div>

      <!-- Team Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 max-w-4xl mx-auto">
  <TeamCard
    name="Jacqueline Dickhaus"
    title="Friseurmeisterin & Inhaberin"
    image="/jacqueline.JPG"
    alt="Jacqueline Dickhaus - Friseurmeisterin"
    description="Mit über 25 Jahren Erfahrung und der Leidenschaft für perfekte Frisuren führt Jacqueline das Team mit Expertise und Herzlichkeit."
    shortDescription="Erfahrung trifft Leidenschaft. Tradition trifft Innovation."
    tags={["Meisterin", "25+ Jahre", "Führung"]}
    colorTheme="primary"
    specialties={[
      "Meisterbetrieb seit 1998 mit höchster Qualität",
      "Perfektion in klassischen und modernen Schnitten",
      "Führung mit Herz und professioneller Struktur",
      "Langjährige Erfahrung als Basis für Vertrauen",
      "Individuelle Lösungen für jeden Wunsch"
    ]}
    quote="Ob traditioneller Schnitt oder zeitloser Stil - Jacqueline bringt mit jeder Schere Bewegung und Schönheit, die Bestand hat."
    isOwner={true}
  />
  <!-- Platzhalter: neue Kollegin - Foto & Steckbrief folgen -->
  <div class="team-card group" data-aos="fade-up">
    <div class="relative bg-white rounded-3xl shadow-xl h-full flex flex-col items-center justify-center text-center p-10 border border-dashed border-branding/30">
      <div class="w-28 h-28 rounded-full bg-branding/10 flex items-center justify-center mb-6">
        <svg class="w-14 h-14 text-branding/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
      </div>
      <h3 class="text-2xl font-bold text-gray-900 mb-2 font-josefin">Neu im Team</h3>
      <p class="text-gray-600 text-sm leading-relaxed max-w-xs">
        Wir haben Verstärkung bekommen! Unsere neue Kollegin stellt sich hier in Kürze mit Foto und Steckbrief vor.
      </p>
      <span class="mt-6 px-4 py-1.5 bg-branding/10 text-branding text-xs rounded-full font-medium">Vorstellung folgt</span>
    </div>
  </div>
</div>
      <!-- Bottom CTA -->
      <div class="text-center mt-16" data-aos="fade-up" data-aos-delay="400">
        <p class="text-gray-600 mb-8 text-lg">
          Bereit für deinen neuen Look? Ruf uns an unter <a href="tel:+4928421219526" class="text-branding hover:underline">02842 1219526</a> oder folge uns auf <a href="https://www.instagram.com/friseur_jacqueline_dickhaus?igsh=MWF4OWJua3hmdTBhaw==" target="_blank" class="text-branding hover:underline">@friseur_jacqueline</a>!
        </p>
      </div>
    </div>
  </div>

  <!-- Wavy Transition -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] rotate-180">
    <svg class="relative block w-[calc(100%+1.3px)] h-[60px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0V46.29c47.89,22,103.78,22,151.67,0,47.89-22,103.78-22,151.67,0,47.89,22,103.78,22,151.67,0,47.89,22,103.78,22,151.67,0,47.89,22,103.78,22,151.67,0,47.89,22,103.78,22,151.67,0V0Z" fill="#f9fafb"></path>
    </svg>
  </div>
</section>

<script is:inline>
  function toggleExpanded(person) {
    const collapsed = document.getElementById(person + '-collapsed');
    const expanded = document.getElementById(person + '-expanded');
    const icon = document.getElementById(person + '-expand-icon');

    if (!collapsed || !expanded || !icon) return;

    const opening = !expanded.classList.contains('hidden');

    if (collapsed.classList.contains('hidden')) {
      collapsed.classList.remove('hidden');
      expanded.classList.add('hidden');
      icon.style.transform = 'rotate(0deg)';
      collapsed.querySelector('button')?.setAttribute('aria-expanded', 'false');
    } else {
      collapsed.classList.add('hidden');
      expanded.classList.remove('hidden');
      icon.style.transform = 'rotate(180deg)';
      expanded.querySelector('button')?.setAttribute('aria-expanded', 'true');

      setTimeout(function () {
        const card = expanded.closest('.team-card');
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }, 100);
    }
  }

  window.toggleExpanded = toggleExpanded;
</script>
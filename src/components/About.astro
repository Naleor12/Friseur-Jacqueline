---
import { SALON } from '../data/salon';
---

<section id="salon" class="scroll-mt-20 bg-sand py-24 lg:py-32 border-b border-linen">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-14">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Rich Dual-Photo Editorial Diptych -->
      <div class="lg:col-span-6 reveal">
        <div class="grid grid-cols-12 gap-4 sm:gap-5 items-end">
          <div class="col-span-7 overflow-hidden rounded-[1.75rem] bg-espresso shadow-xl aspect-[3/4]">
            <img
              src="/images/laden2-opt.webp"
              alt="Gemütliche Lounge mit Samtsesseln und Kunstwerk im Friseursalon Jacqueline Dickhaus"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
          </div>
          <div class="col-span-5 flex flex-col gap-4 sm:gap-5">
            <div class="overflow-hidden rounded-[1.5rem] bg-espresso shadow-lg aspect-[4/3]">
              <img
                src="/images/laden3-opt.webp"
                alt="Empfangs- und Wartebereich bei Friseur Jacqueline Dickhaus"
                class="w-full h-full object-cover object-center"
                loading="lazy"
              />
            </div>
            <div class="bg-espresso text-cream p-5 sm:p-6 rounded-[1.5rem] border border-white/10 shadow-lg">
              <p class="font-serif italic text-lg sm:text-xl leading-snug text-cream/95">
                „Schönheit beginnt in dem Moment, in dem du beschließt, du selbst zu sein.“
              </p>
              <p class="text-[10px] uppercase tracking-editorial text-branding mt-3">
                — Jacqueline Dickhaus
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Philosophy Narrative -->
      <div class="lg:col-span-6 lg:pl-6 space-y-8 reveal reveal-delay-1">
        <div class="space-y-4">
          <p class="text-[11px] uppercase tracking-editorial text-branding-700 font-medium">
            01 — Der Salon
          </p>
          <h2 class="font-serif text-4xl sm:text-5xl xl:text-[3.5rem] text-espresso font-normal leading-[1.08]">
            Mehr als ein Termin –<br />
            <em class="italic font-light text-branding-700">deine bewusste Auszeit.</em>
          </h2>
        </div>

        <div class="space-y-5 text-ink font-light leading-relaxed text-base sm:text-[17px]">
          <p>
            Bei Jacqueline Dickhaus in Kamp-Lintfort dreht sich alles um Stil, Persönlichkeit
            und echtes Meisterhandwerk. Wir nehmen uns bewusst Zeit für dich – vom ersten
            Beratungsgespräch bis zum letzten Finish.
          </p>
          <p>
            Ob präziser Klassiker, sanftes Balayage oder festliche Brautfrisur: In unserer
            ruhigen, warmen Wohlfühlatmosphäre entstehen Looks, die nicht nur im Salon
            überzeugen, sondern sich im Alltag mühelos tragen lassen.
          </p>
        </div>

        <!-- 3 Structured Atelier Pillars -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="bg-cream rounded-2xl border border-linen p-5">
            <p class="font-serif text-3xl text-espresso">{SALON.founded}</p>
            <p class="text-xs text-ink font-medium mt-1">Meisterbetrieb</p>
            <p class="text-xs text-taupe font-light mt-0.5">Über 25 Jahre Erfahrung</p>
          </div>
          <div class="bg-cream rounded-2xl border border-linen p-5">
            <p class="font-serif text-3xl text-espresso">1 : 1</p>
            <p class="text-xs text-ink font-medium mt-1">Persönlich</p>
            <p class="text-xs text-taupe font-light mt-0.5">Ehrliche Typberatung</p>
          </div>
          <div class="bg-cream rounded-2xl border border-linen p-5">
            <p class="font-serif text-3xl text-espresso">Familie</p>
            <p class="text-xs text-ink font-medium mt-1">Für alle Generationen</p>
            <p class="text-xs text-taupe font-light mt-0.5">Damen, Herren &amp; Kids</p>
          </div>
        </div>

        <div class="pt-1 flex flex-wrap items-center gap-6">
          <a
            href="#leistungen"
            class="group inline-flex items-center gap-3 text-xs uppercase tracking-[0.15em] font-medium text-espresso hover:text-branding-700 transition-colors"
          >
            <span>Zu Leistungen &amp; Preisen</span>
            <span class="w-8 h-px bg-espresso group-hover:bg-branding-700 group-hover:w-12 transition-all duration-300"></span>
          </a>
          <a
            href="#galerie"
            class="text-xs uppercase tracking-[0.15em] font-medium text-taupe hover:text-espresso transition-colors"
          >
            Salon-Galerie →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

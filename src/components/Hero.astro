---
import { SALON } from '../data/salon';

const highlights = [
  "Friseurmeisterin seit 1998",
  "Damen, Herren & Kinder",
  "Balayage & Farbberatung",
  "Braut- & Anlassstyling",
  "Wiesenbruchstraße 39 · Kamp-Lintfort",
];
---

<section id="hero" class="relative pt-20 bg-cream overflow-hidden flex flex-col min-h-[100svh]">
  <!-- Edge-to-Edge Split Architecture -->
  <div class="flex-1 grid lg:grid-cols-12 relative">
    <!-- Left Editorial Pane -->
    <div class="lg:col-span-6 xl:col-span-5 relative flex items-center bg-gradient-to-br from-cream via-cream to-sand/80 px-6 sm:px-10 lg:px-14 xl:px-20 py-16 lg:py-20 border-r border-linen/80 overflow-hidden">
      <!-- Subtle Architectural Watermark Monogram -->
      <img
        src="/images/JD_Logo_dark_RGB.png"
        alt=""
        aria-hidden="true"
        width="420"
        height="109"
        decoding="async"
        class="pointer-events-none select-none absolute -bottom-12 -left-16 w-[420px] opacity-[0.045] rotate-[-8deg]"
      />

      <div class="relative z-10 w-full max-w-xl mx-auto lg:mx-0 lg:ml-auto space-y-8">
        <!-- Eyebrow + Verified Google Rating Pill -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="inline-flex items-center gap-3">
            <span class="w-8 h-px bg-branding-500"></span>
            <span class="text-[11px] uppercase tracking-editorial text-branding-700 font-medium">
              Friseurmeisterin seit {SALON.masterSince} · {SALON.address.city}
            </span>
          </div>
          <a
            href={SALON.googleUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 bg-sand border border-linen hover:border-branding-400 px-3 py-1 rounded-full text-[11px] text-espresso font-medium transition-colors"
            title="Unsere Bewertungen auf Google ansehen"
          >
            <svg class="w-3.5 h-3.5 text-branding-600 fill-current" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.447a1 1 0 00-.364 1.118l1.286 3.958c.3.921-.755 1.688-1.539 1.118l-3.368-2.447a1 1 0 00-1.176 0l-3.368 2.447c-.784.57-1.838-.197-1.539-1.118l1.286-3.958a1 1 0 00-.364-1.118L2.075 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.274-3.958z" />
            </svg>
            <span>{SALON.rating.score} auf Google</span>
          </a>
        </div>

        <!-- Monumental Editorial Heading -->
        <h1 class="font-serif text-5xl sm:text-6xl xl:text-[5rem] leading-[1.01] font-normal text-espresso tracking-[-0.02em]">
          Handwerk,<br />
          <em class="italic font-light text-branding-700">das bleibt.</em>
        </h1>

        <p class="text-base sm:text-lg text-ink font-light leading-relaxed max-w-md">
          Zeitlose Schnitte, lebendige Farbtechniken und persönliche Beratung für Damen,
          Herren &amp; Kinder – in entspannter Wohlfühlatmosphäre bei Jacqueline Dickhaus.
        </p>

        <!-- Primary & Secondary CTA -->
        <div class="flex flex-wrap items-center gap-4 pt-1">
          <a
            href={SALON.phoneHref}
            class="group inline-flex items-center gap-3 bg-espresso text-cream px-7 py-4 rounded-full text-xs uppercase tracking-[0.15em] font-medium hover:bg-bark transition-all duration-300 hover:shadow-lg"
          >
            <svg class="w-4 h-4 text-branding transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Termin: {SALON.phoneDisplay}</span>
          </a>

          <a
            href="#leistungen"
            class="group inline-flex items-center gap-2.5 border border-espresso/20 bg-cream/70 px-6 py-4 rounded-full text-xs uppercase tracking-[0.15em] font-medium text-espresso hover:border-espresso hover:bg-cream transition-all"
          >
            <span>Preise ansehen</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Structured Salon Details Card -->
        <div class="pt-7 mt-4 border-t border-linen grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-1">
            <div class="flex items-center gap-2 text-[11px] uppercase tracking-editorial text-taupe">
              <span id="hero-status-dot" class="w-2 h-2 rounded-full bg-taupe/50"></span>
              <span id="hero-status-label">Öffnungszeiten</span>
            </div>
            <p class="text-sm text-espresso font-medium">
              Di–Fr 09:00–18:00 · Sa 09:00–14:00
            </p>
          </div>

          <div class="space-y-1">
            <p class="text-[11px] uppercase tracking-editorial text-taupe">Standort</p>
            <a
              href={SALON.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-espresso font-medium hover:text-branding-700 transition-colors inline-flex items-center gap-1.5"
            >
              <span>{SALON.address.street}, {SALON.address.city}</span>
              <svg class="w-3.5 h-3.5 text-taupe flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Full-Bleed Architectural Salon Stage -->
    <div class="lg:col-span-6 xl:col-span-7 relative min-h-[440px] sm:min-h-[540px] lg:min-h-0 bg-espresso overflow-hidden">
      <img
        src="/images/laden1-opt.webp"
        alt="Innenansicht von Friseur Jacqueline Dickhaus in Kamp-Lintfort mit warmen Holzlamellen und modernen Styling-Plätzen"
        width="1600"
        height="1066"
        class="absolute inset-0 w-full h-full object-cover object-center scale-[1.01]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <!-- Rich Warm Editorial Vignette -->
      <div class="absolute inset-0 bg-gradient-to-t from-espresso/80 via-espresso/20 to-espresso/10"></div>

      <!-- Top-Right Subtle Editorial Tag -->
      <div class="hidden sm:flex items-center gap-3 absolute top-7 right-7 bg-espresso/65 backdrop-blur-md border border-white/15 px-4 py-2 rounded-full text-cream">
        <img src="/images/JD_Logo_light_RGB.svg" alt="" aria-hidden="true" width="77" height="20" decoding="async" class="h-5 w-auto" />
        <span class="text-[11px] uppercase tracking-editorial text-cream/90">
          {SALON.experienceYears} Jahre Meisterhandwerk
        </span>
      </div>

      <!-- Clean Bottom Staging Bar (Zero Overlap!) -->
      <div class="absolute bottom-6 left-6 right-6 sm:bottom-10 sm:left-10 sm:right-10 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
        <div class="space-y-1.5 text-cream max-w-md">
          <p class="text-[11px] uppercase tracking-editorial text-branding">
            Dein Friseursalon in Kamp-Lintfort
          </p>
          <p class="font-serif text-3xl sm:text-4xl font-light leading-tight">
            Warmes Holz. Ruhiges Licht.<br />
            <span class="italic text-branding">Zeit für deinen Look.</span>
          </p>
        </div>

        <!-- Secondary Lounge Inset Preview (Cleanly separated on the right) -->
        <a
          href="#salon"
          class="hidden xl:flex items-center gap-4 bg-cream/95 backdrop-blur-md border border-linen/80 rounded-2xl p-3.5 shadow-2xl max-w-[270px] hover:bg-cream transition-colors group"
        >
          <img
            src="/images/laden2-opt.webp"
            alt="Salon-Lounge bei Jacqueline Dickhaus"
            width="1400"
            height="1925"
            decoding="async"
            class="w-16 h-20 object-cover rounded-xl flex-shrink-0"
            loading="eager"
          />
          <div class="pr-1">
            <p class="text-[10px] uppercase tracking-editorial text-branding-700 font-medium">
              Salon-Erlebnis
            </p>
            <p class="font-serif text-xl text-espresso leading-snug mt-0.5 group-hover:text-branding-700 transition-colors">
              Ankommen &amp; wohlfühlen
            </p>
            <span class="inline-flex items-center gap-1 text-[11px] text-taupe mt-1">
              <span>Mehr entdecken</span>
              <span>→</span>
            </span>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- Full-Width Espresso Atelier Ribbon -->
  <div class="bg-espresso text-cream border-t border-white/10">
    <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-14 py-4">
      <div class="flex flex-wrap items-center justify-center lg:justify-between gap-x-8 gap-y-2 text-[11px] uppercase tracking-editorial text-cream/85">
        {highlights.map((item, idx) => (
          <div class="flex items-center gap-8">
            <span class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rotate-45 bg-branding flex-shrink-0"></span>
              <span>{item}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function updateOpenStatus() {
    try {
      const now = new Date();
      const berlinFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Europe/Berlin',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      });
      const parts = berlinFormatter.formatToParts(now);
      const weekday = parts.find((p) => p.type === 'weekday')?.value || '';
      const hour = parseInt(parts.find((p) => p.type === 'hour')?.value || '0', 10);
      const minute = parseInt(parts.find((p) => p.type === 'minute')?.value || '0', 10);
      const mins = hour * 60 + minute;

      let isOpen = false;
      if (['Tue', 'Wed', 'Thu', 'Fri'].includes(weekday)) {
        isOpen = mins >= 9 * 60 && mins < 18 * 60;
      } else if (weekday === 'Sat') {
        isOpen = mins >= 9 * 60 && mins < 14 * 60;
      }

      const heroDot = document.getElementById('hero-status-dot');
      const heroLabel = document.getElementById('hero-status-label');
      const contactBadge = document.getElementById('contact-open-badge');

      if (heroDot && heroLabel) {
        heroDot.className = isOpen
          ? 'w-2 h-2 rounded-full bg-emerald-600'
          : 'w-2 h-2 rounded-full bg-branding-500';
        heroLabel.textContent = isOpen ? 'Jetzt geöffnet' : 'Aktuell geschlossen';
      }

      if (contactBadge) {
        contactBadge.textContent = isOpen ? 'Jetzt geöffnet' : 'Derzeit geschlossen';
        contactBadge.className = isOpen
          ? 'inline-flex items-center gap-2 text-xs font-medium px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200'
          : 'inline-flex items-center gap-2 text-xs font-medium px-3.5 py-1.5 rounded-full bg-branding-100 text-branding-800 border border-branding-200';
      }
    } catch {
      // Fallback stays neutral
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateOpenStatus);
  } else {
    updateOpenStatus();
  }
</script>

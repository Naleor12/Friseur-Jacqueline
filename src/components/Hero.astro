---
---
<section
  id="hero"
  class="scroll-mt-24 relative bg-center bg-cover bg-no-repeat text-left text-white h-[100vh] flex items-center px-4 sm:px-10 lg:px-24 xl:px-32 overflow-hidden"
  style="background-image: url('/images/2bw.jpg')"
>
  <!-- Overlay für Lesbarkeit -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/40 to-transparent z-0"></div>

  <!-- Main Content -->
  <div id="hero-content" class="relative z-20 max-w-4xl space-y-8 opacity-0 animate-fadeInDelayed">
    <!-- Floating Logo -->
    <div class="logo-container animate-float">
      <img
        src="/images/JD_Logo_light_RGB.svg"
        alt="Jacqueline Dickhaus Logo"
        class="h-20 sm:h-24 md:h-28 drop-shadow-lg transition-transform duration-300 hover:scale-105"
        loading="eager"
      />
    </div>
    
    <!-- Echte H1 für Suchmaschinen/Screenreader (unsichtbar), Tipp-Effekt bleibt visuell -->
    <h1 class="sr-only">Friseur Jacqueline Dickhaus – Moderne Frisuren für Damen, Herren &amp; Kinder in Kamp-Lintfort</h1>
    <div class="headline-container" aria-hidden="true">
      <div class="text-4xl sm:text-5xl md:text-6xl font-josefin font-bold text-white drop-shadow-lg leading-tight">
        <span id="typing-text" class="typing-cursor"></span>
      </div>
    </div>
    
    <!-- Subtitle with Animation -->
    <p class="text-lg sm:text-xl md:text-2xl text-white/95 font-light leading-relaxed animate-slideUpDelayed max-w-2xl">
      Moderne Frisuren für Damen, Herren & Kinder – willkommen bei Jacqueline Dickhaus.
    </p>
    
    <!-- Enhanced Contact Options -->
    <div class="flex flex-col sm:flex-row gap-4 animate-slideUpDelayed" style="animation-delay: 0.8s;">
      <a
        href="tel:+4928421219526"
        class="group inline-flex items-center justify-center bg-branding text-white px-6 py-3 rounded-full font-medium text-base transition-all duration-300 hover:bg-branding-600 hover:scale-105 hover:shadow-2xl"
      >
        <svg class="w-5 h-5 mr-2 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
        </svg>
        <span>Anrufen: 02842 1219526</span>
      </a>
      <a
        href="https://www.instagram.com/friseur_jacqueline_dickhaus?igsh=MWF4OWJua3hmdTBhaw=="
        target="_blank"
        class="group inline-flex items-center justify-center bg-branding text-white px-6 py-3 rounded-full font-medium text-base transition-all duration-300 hover:bg-branding-600 hover:scale-105 hover:shadow-2xl"
      >
        <svg class="w-5 h-5 mr-2 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
          <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm5.25-.75a .75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z" />
        </svg>
        <span>Folge uns: @friseur_jacqueline</span>
      </a>
    </div>
  </div>
  
  <!-- Scroll Down Indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 text-white animate-bounce z-20">
    <div class="flex flex-col items-center cursor-pointer group" onclick="document.getElementById('ueber-uns').scrollIntoView({behavior: 'smooth'})">
      <span class="text-sm font-light mb-2 opacity-80 group-hover:opacity-100 transition-opacity">Mehr erfahren</span>
      <svg class="w-6 h-6 animate-bounce-slow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  /* Typing Effect */
  .typing-cursor::after {
    content: '|';
    animation: blink 1s infinite;
    color: #d5b6b8;
  }
  
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  
  /* Sanftes Schweben des Logos */
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }

  /* Enhanced Fade In */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fadeInDelayed {
    animation: fadeInUp 1s ease-out 0.5s forwards;
  }
  
  .animate-slideUpDelayed {
    opacity: 0;
    animation: fadeInUp 0.8s ease-out 0.7s forwards;
  }
  
  /* Bounce Slow */
  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  
  .animate-bounce-slow {
    animation: bounce-slow 2s ease-in-out infinite;
  }
</style>

<script>
  document.addEventListener('astro:page-load', initHero);
  
  // Also init immediately if astro:page-load already fired
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
  
  function initHero() {
    console.log('Initializing hero...');
    
    // Typing Effect
    const typingElement = document.getElementById('typing-text');
    const phrases = [
      'Dein Style. Unser Handwerk.',
      'Moderne Frisuren. Echte Kunst.',
      'Dein Look. Unsere Leidenschaft.'
    ];
    
    let currentPhrase = 0;
    let currentChar = 0;
    let isDeleting = false;
    
    function typeEffect() {
      if (!typingElement) return;
      
      const phrase = phrases[currentPhrase];
      
      if (isDeleting) {
        typingElement.textContent = phrase.substring(0, currentChar - 1);
        currentChar--;
        
        if (currentChar === 0) {
          isDeleting = false;
          currentPhrase = (currentPhrase + 1) % phrases.length;
          setTimeout(typeEffect, 500);
        } else {
          setTimeout(typeEffect, 50);
        }
      } else {
        typingElement.textContent = phrase.substring(0, currentChar + 1);
        currentChar++;
        
        if (currentChar === phrase.length) {
          setTimeout(() => {
            isDeleting = true;
            typeEffect();
          }, 2000);
        } else {
          setTimeout(typeEffect, 100);
        }
      }
    }

    // Start typing effect
    setTimeout(typeEffect, 1000);
  }
</script>
---
// CookieBanner.astro
---

<!-- Cookie Banner -->
<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-50 transform translate-y-full transition-transform duration-500 ease-out">
  <div class="bg-white/95 backdrop-blur-md border-t border-gray-200 shadow-2xl">
    <div class="max-w-7xl mx-auto px-4 py-6">
      <div class="flex flex-col lg:flex-row items-start lg:items-center gap-6">
        
        <!-- Content -->
        <div class="flex-1">
          <div class="flex items-start gap-4">
            <!-- Cookie Icon -->
            <div class="flex-shrink-0 w-12 h-12 bg-branding/10 rounded-full flex items-center justify-center mt-1">
              <svg class="w-6 h-6 text-branding" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                <circle cx="9" cy="9" r="1"/>
                <circle cx="15" cy="9" r="1"/>
                <circle cx="12" cy="15" r="1"/>
                <circle cx="9" cy="15" r="1"/>
                <circle cx="15" cy="15" r="1"/>
              </svg>
            </div>
            
            <div>
              <h3 class="text-lg font-semibold text-gray-900 font-josefin mb-2">
                Wir respektieren deine Privatsphäre
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed max-w-2xl">
                Wir verwenden Cookies und ähnliche Technologien, um die bestmögliche Erfahrung auf unserer Website zu bieten und unsere Services zu verbessern. 
                <button id="cookie-details-btn" class="text-branding hover:underline font-medium">
                  Mehr erfahren
                </button>
              </p>
            </div>
          </div>
        </div>
        
        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 lg:flex-shrink-0">
          <button id="cookie-settings-btn" class="px-6 py-3 border border-gray-300 text-gray-700 rounded-full font-medium hover:bg-gray-50 transition-all duration-200 text-sm">
            Einstellungen
          </button>
          <button id="cookie-reject-btn" class="px-6 py-3 border border-gray-300 text-gray-700 rounded-full font-medium hover:bg-gray-50 transition-all duration-200 text-sm">
            Ablehnen
          </button>
          <button id="cookie-accept-btn" class="px-6 py-3 bg-branding text-white rounded-full font-medium hover:bg-branding-600 transition-all duration-200 text-sm">
            Alle akzeptieren
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Cookie Settings Modal -->
<div id="cookie-modal" class="fixed inset-0 z-60 hidden">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div class="relative min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      
      <!-- Header -->
      <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 rounded-t-2xl">
        <div class="flex items-center justify-between">
          <h2 class="text-2xl font-bold text-gray-900 font-josefin">Cookie-Einstellungen</h2>
          <button id="cookie-modal-close" class="w-8 h-8 bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition-colors">
            <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Content -->
      <div class="p-6 space-y-6">
        
        <!-- Description -->
        <div>
          <p class="text-gray-600 leading-relaxed">
            Wir verwenden verschiedene Arten von Cookies, um deine Erfahrung auf unserer Website zu verbessern. 
            Du kannst wählen, welche Kategorien du zulassen möchtest.
          </p>
        </div>
        
        <!-- Cookie Categories -->
        <div class="space-y-4">
          
          <!-- Essential Cookies -->
          <div class="border border-gray-200 rounded-xl p-4">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-gray-900 font-josefin">Notwendige Cookies</h3>
              <div class="flex items-center">
                <input type="checkbox" id="essential-cookies" checked disabled class="w-4 h-4 text-branding border-gray-300 rounded focus:ring-branding opacity-50">
                <label for="essential-cookies" class="ml-2 text-sm text-gray-500">Immer aktiv</label>
              </div>
            </div>
            <p class="text-sm text-gray-600">
              Diese Cookies sind für das ordnungsgemäße Funktionieren der Website erforderlich und können nicht deaktiviert werden.
            </p>
          </div>
          
          <!-- Analytics Cookies -->
          <div class="border border-gray-200 rounded-xl p-4">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-gray-900 font-josefin">Analyse-Cookies</h3>
              <div class="relative">
                <input type="checkbox" id="analytics-cookies" class="sr-only">
                <label for="analytics-cookies" class="flex items-center cursor-pointer">
                  <div class="toggle-bg w-11 h-6 bg-gray-200 rounded-full border border-gray-300 transition-colors duration-200"></div>
                  <div class="toggle-dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-200 shadow-sm"></div>
                </label>
              </div>
            </div>
            <p class="text-sm text-gray-600">
              Helfen uns zu verstehen, wie Besucher mit der Website interagieren, um unsere Services zu verbessern.
            </p>
            <p class="text-xs text-gray-500 mt-2">
              <strong>Anbieter:</strong> Google Analytics, Matomo
            </p>
          </div>
          
          <!-- Marketing Cookies -->
          <div class="border border-gray-200 rounded-xl p-4">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-gray-900 font-josefin">Marketing-Cookies</h3>
              <div class="relative">
                <input type="checkbox" id="marketing-cookies" class="sr-only">
                <label for="marketing-cookies" class="flex items-center cursor-pointer">
                  <div class="toggle-bg w-11 h-6 bg-gray-200 rounded-full border border-gray-300 transition-colors duration-200"></div>
                  <div class="toggle-dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-200 shadow-sm"></div>
                </label>
              </div>
            </div>
            <p class="text-sm text-gray-600">
              Ermöglichen es uns, dir relevante Werbung und Inhalte basierend auf deinen Interessen zu zeigen.
            </p>
            <p class="text-xs text-gray-500 mt-2">
              <strong>Anbieter:</strong> Google Ads, Facebook Pixel, Instagram
            </p>
          </div>
          
        </div>
        
        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-200">
          <button id="cookie-save-settings" class="flex-1 px-6 py-3 border border-gray-300 text-gray-700 rounded-full font-medium hover:bg-gray-50 transition-all duration-200">
            Auswahl speichern
          </button>
          <button id="cookie-accept-all-modal" class="flex-1 px-6 py-3 bg-branding text-white rounded-full font-medium hover:bg-branding-600 transition-all duration-200">
            Alle akzeptieren
          </button>
        </div>
        
        <!-- Legal Links -->
        <div class="text-center pt-4 border-t border-gray-200">
          <p class="text-xs text-gray-500">
            Weitere Informationen findest du in unserer 
            <a href="/datenschutz" class="text-branding hover:underline">Datenschutzerklärung</a> und unserem 
            <a href="/impressum" class="text-branding hover:underline">Impressum</a>.
          </p>
        </div>
        
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('astro:page-load', initCookieBanner);

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initCookieBanner);
} else {
  initCookieBanner();
}

function initCookieBanner() {
  console.log('Initializing cookie banner...');
  
  const banner = document.getElementById('cookie-banner');
  const modal = document.getElementById('cookie-modal');
  const acceptBtn = document.getElementById('cookie-accept-btn');
  const rejectBtn = document.getElementById('cookie-reject-btn');
  const settingsBtn = document.getElementById('cookie-settings-btn');
  const detailsBtn = document.getElementById('cookie-details-btn');
  const modalCloseBtn = document.getElementById('cookie-modal-close');
  const saveSettingsBtn = document.getElementById('cookie-save-settings');
  const acceptAllModalBtn = document.getElementById('cookie-accept-all-modal');
  
  // Cookie consent status
  const COOKIE_NAME = 'friseur-cookie-consent';
  const COOKIE_EXPIRY = 365; // days
  
  // Check if consent already given
  const existingConsent = getCookie(COOKIE_NAME);
  if (!existingConsent) {
    showBanner();
  }
  
  // Event listeners
  acceptBtn?.addEventListener('click', () => acceptAllCookies());
  rejectBtn?.addEventListener('click', () => rejectAllCookies());
  settingsBtn?.addEventListener('click', () => openModal());
  detailsBtn?.addEventListener('click', () => openModal());
  modalCloseBtn?.addEventListener('click', () => closeModal());
  saveSettingsBtn?.addEventListener('click', () => saveCustomSettings());
  acceptAllModalBtn?.addEventListener('click', () => acceptAllCookies());
  
  // Toggle switches
  setupToggleSwitches();
  
  // Close modal on backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  
  function showBanner() {
    if (!banner) return;
    setTimeout(() => {
      banner.style.transform = 'translateY(0)';
    }, 1000); // Show after 1 second
  }
  
  function hideBanner() {
    if (!banner) return;
    banner.style.transform = 'translateY(100%)';
  }
  
  function openModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  
  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }
  
  function acceptAllCookies() {
    const consent = {
      essential: true,
      analytics: true,
      marketing: true,
      timestamp: new Date().toISOString()
    };
    
    setCookie(COOKIE_NAME, JSON.stringify(consent), COOKIE_EXPIRY);
    hideBanner();
    closeModal();
    
    // Enable all tracking
    enableAnalytics();
    enableMarketing();
    
    console.log('All cookies accepted');
  }
  
  function rejectAllCookies() {
    const consent = {
      essential: true,
      analytics: false,
      marketing: false,
      timestamp: new Date().toISOString()
    };
    
    setCookie(COOKIE_NAME, JSON.stringify(consent), COOKIE_EXPIRY);
    hideBanner();
    closeModal();
    
    console.log('All non-essential cookies rejected');
  }
  
  function saveCustomSettings() {
    const analyticsElement = document.getElementById('analytics-cookies') as HTMLInputElement;
    const marketingElement = document.getElementById('marketing-cookies') as HTMLInputElement;
    const analyticsChecked = analyticsElement?.checked || false;
    const marketingChecked = marketingElement?.checked || false;
    
    const consent = {
      essential: true,
      analytics: analyticsChecked,
      marketing: marketingChecked,
      timestamp: new Date().toISOString()
    };
    
    setCookie(COOKIE_NAME, JSON.stringify(consent), COOKIE_EXPIRY);
    hideBanner();
    closeModal();
    
    // Enable selected tracking
    if (analyticsChecked) enableAnalytics();
    if (marketingChecked) enableMarketing();
    
    console.log('Custom cookie settings saved:', consent);
  }
  
  function setupToggleSwitches() {
    const toggles = document.querySelectorAll('input[type="checkbox"]:not(#essential-cookies)');
    
    toggles.forEach(toggle => {
      const toggleElement = toggle as HTMLInputElement;
      const label = toggle.nextElementSibling;
      const bg = label?.querySelector('.toggle-bg');
      const dot = label?.querySelector('.toggle-dot');
      
      toggleElement.addEventListener('change', () => {
        const bgElement = bg as HTMLElement;
        const dotElement = dot as HTMLElement;
        
        if (toggleElement.checked) {
          bgElement?.classList.add('bg-branding');
          bgElement?.classList.remove('bg-gray-200');
          if (dotElement) dotElement.style.transform = 'translateX(20px)';
        } else {
          bgElement?.classList.remove('bg-branding');
          bgElement?.classList.add('bg-gray-200');
          if (dotElement) dotElement.style.transform = 'translateX(0)';
        }
      });
    });
  }
  
  function enableAnalytics() {
    // Add your analytics code here
    // Example: Google Analytics
    console.log('Analytics enabled');
    
    // window.gtag('consent', 'update', {
    //   'analytics_storage': 'granted'
    // });
  }
  
  function enableMarketing() {
    // Add your marketing tracking code here
    console.log('Marketing enabled');
    
    // window.gtag('consent', 'update', {
    //   'ad_storage': 'granted'
    // });
  }
  
  // Utility functions
  function setCookie(name: string, value: string, days: number): void {
    const expires = new Date();
    expires.setTime(expires.getTime() + (days * 24 * 60 * 60 * 1000));
    document.cookie = `${name}=${value};expires=${expires.toUTCString()};path=/;SameSite=Lax`;
  }
  
  function getCookie(name: string): string | null {
    const nameEQ = name + "=";
    const ca = document.cookie.split(';');
    for (let i = 0; i < ca.length; i++) {
      let c = ca[i];
      while (c.charAt(0) === ' ') c = c.substring(1, c.length);
      if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
    }
    return null;
  }
  
  console.log('Cookie banner initialized');
}
</script>

<style>
/* Custom toggle switch styles */
.toggle-bg.bg-branding {
  background-color: #d5b6b8;
}

/* Smooth animations */
.toggle-dot {
  transition: transform 0.2s ease-in-out;
}

/* Custom scrollbar for modal */
.overflow-y-auto::-webkit-scrollbar {
  width: 6px;
}

.overflow-y-auto::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3px;
}

.overflow-y-auto::-webkit-scrollbar-thumb {
  background: #d5b6b8;
  border-radius: 3px;
}

.overflow-y-auto::-webkit-scrollbar-thumb:hover {
  background: #c09ea0;
}
</style>
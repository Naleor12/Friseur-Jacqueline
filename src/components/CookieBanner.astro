---
// Discreet Warm Editorial Cookie Banner
---

<div
  id="cookie-banner"
  class="fixed bottom-20 md:bottom-6 left-4 right-4 md:left-auto md:right-6 md:max-w-md z-50 translate-y-[140%] opacity-0 transition-all duration-500 ease-editorial pointer-events-none"
  role="region"
  aria-label="Datenschutz-Hinweis"
>
  <div class="pointer-events-auto bg-cream/98 backdrop-blur-md border border-linen rounded-2xl shadow-2xl p-6 space-y-4">
    <div class="space-y-1.5">
      <p class="text-[10px] uppercase tracking-editorial text-branding-700 font-medium">
        Privatsphäre
      </p>
      <h3 class="font-serif text-2xl text-espresso font-normal">
        Einstellungen zu Cookies
      </h3>
      <p class="text-xs text-ink font-light leading-relaxed">
        Wir nutzen technisch notwendige Cookies für einen reibungslosen Ablauf. Mehr Details findest du in unserer
        <a href="/Datenschutz" class="text-branding-700 underline underline-offset-2 hover:text-espresso">
          Datenschutzerklärung
        </a>.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2 pt-1">
      <button
        id="cookie-accept-btn"
        type="button"
        class="flex-1 bg-espresso text-cream px-4 py-2.5 rounded-full text-xs uppercase tracking-[0.12em] font-medium hover:bg-bark transition-colors"
      >
        Akzeptieren
      </button>
      <button
        id="cookie-reject-btn"
        type="button"
        class="px-4 py-2.5 rounded-full border border-linen text-ink hover:text-espresso hover:bg-sand text-xs uppercase tracking-[0.12em] font-medium transition-colors"
      >
        Nur notwendige
      </button>
    </div>
  </div>
</div>

<script>
  function initCookieBanner() {
    const COOKIE_NAME = 'friseur-cookie-consent';
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept-btn');
    const rejectBtn = document.getElementById('cookie-reject-btn');

    const getCookie = (name: string) => {
      const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
      return match ? match[2] : null;
    };

    const setCookie = (value: string) => {
      const expires = new Date(Date.now() + 365 * 86400 * 1000).toUTCString();
      document.cookie = `${COOKIE_NAME}=${value};expires=${expires};path=/;SameSite=Lax`;
    };

    const hide = () => {
      if (!banner) return;
      banner.classList.add('translate-y-[140%]', 'opacity-0', 'pointer-events-none');
    };

    const show = () => {
      if (!banner) return;
      banner.classList.remove('translate-y-[140%]', 'opacity-0', 'pointer-events-none');
    };

    if (!getCookie(COOKIE_NAME)) {
      setTimeout(show, 900);
    }

    acceptBtn?.addEventListener('click', () => {
      setCookie(JSON.stringify({ essential: true, analytics: true, timestamp: new Date().toISOString() }));
      hide();
    });

    rejectBtn?.addEventListener('click', () => {
      setCookie(JSON.stringify({ essential: true, analytics: false, timestamp: new Date().toISOString() }));
      hide();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookieBanner);
  } else {
    initCookieBanner();
  }
</script>

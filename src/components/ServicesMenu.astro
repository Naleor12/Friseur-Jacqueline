---
import { SALON } from '../data/salon';

interface ServiceItem {
  title: string;
  text: string;
  duration?: string;
  price: string;
  highlight?: boolean;
}

interface Props {
  initialData: Record<string, ServiceItem[]>;
}

const { initialData } = Astro.props;

const TAB_LABELS: Record<string, string> = {
  damen: 'Damen',
  herren: 'Herren',
  kids: 'Kinder',
};

const tabs = Object.keys(initialData);
---

<div id="services-menu">
  <!-- Minimalist Editorial Category Switcher -->
  <div
    role="tablist"
    aria-label="Leistungskategorien"
    class="flex justify-center items-center gap-2 sm:gap-4 mb-14 border-b border-linen pb-4"
  >
    {tabs.map((tab, i) => {
      const isActive = i === 0;
      const label = TAB_LABELS[tab] || tab.charAt(0).toUpperCase() + tab.slice(1);
      return (
        <button
          role="tab"
          type="button"
          id={`tab-${tab}`}
          data-service-tab={tab}
          aria-selected={isActive ? 'true' : 'false'}
          aria-controls={`panel-${tab}`}
          class={`service-tab relative px-6 sm:px-9 py-2.5 rounded-full text-xs uppercase tracking-[0.16em] font-medium transition-all duration-300 ${
            isActive
              ? 'bg-espresso text-cream shadow-sm'
              : 'text-ink hover:text-espresso hover:bg-cream'
          }`}
        >
          {label}
        </button>
      );
    })}
  </div>

  <!-- Static SEO-friendly Price Panels -->
  {tabs.map((tab, i) => {
    const items = initialData[tab] || [];
    const isActive = i === 0;
    return (
      <div
        role="tabpanel"
        id={`panel-${tab}`}
        aria-labelledby={`tab-${tab}`}
        data-service-panel={tab}
        class={`service-panel grid grid-cols-1 md:grid-cols-2 gap-x-14 gap-y-2 ${isActive ? '' : 'hidden'}`}
      >
        {items.map((service) => (
          <article class="group py-6 border-b border-linen flex flex-col justify-between transition-colors duration-300">
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <div class="flex items-center flex-wrap gap-2.5">
                  <h3 class="font-serif text-2xl text-espresso group-hover:text-branding-700 transition-colors">
                    {service.title}
                  </h3>
                  {service.highlight && (
                    <span class="text-[10px] uppercase tracking-[0.14em] px-2.5 py-0.5 rounded-full bg-branding-100 text-branding-800 font-medium">
                      Beliebt
                    </span>
                  )}
                </div>
                <span class="font-sans text-base sm:text-lg font-medium text-espresso whitespace-nowrap">
                  {service.price}
                </span>
              </div>

              <p class="text-sm text-ink font-light leading-relaxed mt-2.5 pr-4">
                {service.text}
              </p>
            </div>

            {service.duration && (
              <div class="mt-3 flex items-center gap-1.5 text-[11px] uppercase tracking-wider text-taupe">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Dauer: {service.duration}</span>
              </div>
            )}
          </article>
        ))}
      </div>
    );
  })}

  <!-- Single High-Contrast Consultation Callout -->
  <div class="mt-16 rounded-[1.75rem] bg-espresso text-cream px-7 py-10 sm:px-12 sm:py-12 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
    <div class="space-y-2 max-w-xl">
      <p class="text-[11px] uppercase tracking-editorial text-branding">
        Persönliche Beratung
      </p>
      <h3 class="font-serif text-3xl sm:text-4xl font-normal text-cream">
        Unsicher, welcher Look zu dir passt?
      </h3>
      <p class="text-sm text-cream/75 font-light leading-relaxed">
        Ruf uns einfach kurz an oder lass dich auf Instagram inspirieren – wir beraten
        dich ehrlich zu Schnitt, Farbtechnik und Pflegeaufwand.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3.5 flex-shrink-0">
      <a
        href={SALON.phoneHref}
        class="inline-flex items-center gap-2.5 bg-branding text-espresso px-6 py-3.5 rounded-full text-xs uppercase tracking-[0.15em] font-semibold hover:bg-branding-200 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>{SALON.phoneDisplay}</span>
      </a>
      <a
        href={SALON.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-white/25 text-cream px-6 py-3.5 rounded-full text-xs uppercase tracking-[0.15em] font-medium hover:border-branding hover:text-branding transition-colors"
      >
        <span>Instagram</span>
      </a>
    </div>
  </div>
</div>

<script>
  function initServicesMenu() {
    const tabs = document.querySelectorAll('.service-tab') as NodeListOf<HTMLButtonElement>;
    const panels = document.querySelectorAll('.service-panel') as NodeListOf<HTMLElement>;

    const activate = (target: string) => {
      tabs.forEach((btn) => {
        const isActive = btn.dataset.serviceTab === target;
        btn.setAttribute('aria-selected', String(isActive));
        btn.classList.toggle('bg-espresso', isActive);
        btn.classList.toggle('text-cream', isActive);
        btn.classList.toggle('shadow-sm', isActive);
        btn.classList.toggle('text-ink', !isActive);
      });

      panels.forEach((panel) => {
        const isMatch = panel.dataset.servicePanel === target;
        panel.classList.toggle('hidden', !isMatch);
      });
    };

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.serviceTab) activate(btn.dataset.serviceTab);
      });
    });

    window.addEventListener('selectServiceTab', (event: Event) => {
      const custom = event as CustomEvent<{ tab?: string }>;
      if (custom.detail?.tab) activate(custom.detail.tab);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServicesMenu);
  } else {
    initServicesMenu();
  }
</script>

---
import { SALON } from '../data/salon';
---

<footer class="bg-espresso text-cream border-t border-white/10 pb-24 md:pb-0">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-14 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-14 border-b border-white/10">
      <!-- Brand Column -->
      <div class="md:col-span-5 space-y-5">
        <a href="/#hero" class="inline-flex items-center gap-3.5">
          <img
            src="/images/JD_Logo_light_RGB.svg"
            alt="Jacqueline Dickhaus Monogramm"
            width="170"
            height="44"
            decoding="async"
            class="h-11 w-auto"
          />
          <div class="flex flex-col leading-none">
            <span class="font-serif text-2xl text-cream tracking-wide">Jacqueline Dickhaus</span>
            <span class="text-[10px] uppercase tracking-editorial text-branding mt-1">
              Meisterbetrieb seit {SALON.founded}
            </span>
          </div>
        </a>
        <p class="text-sm text-cream/65 font-light leading-relaxed max-w-sm">
          Moderne Schnitte, natürliche Farbtechniken und persönliche Beratung für Damen, Herren
          &amp; Kinder in Kamp-Lintfort.
        </p>
      </div>

      <!-- Navigation Column -->
      <div class="md:col-span-3 space-y-4">
        <p class="text-[11px] uppercase tracking-editorial text-branding">Navigation</p>
        <ul class="space-y-2.5 text-sm text-cream/75 font-light">
          <li><a href="/#salon" class="hover:text-branding transition-colors">Der Salon</a></li>
          <li><a href="/#leistungen" class="hover:text-branding transition-colors">Leistungen &amp; Preise</a></li>
          <li><a href="/#team" class="hover:text-branding transition-colors">Team</a></li>
          <li><a href="/#galerie" class="hover:text-branding transition-colors">Galerie</a></li>
          <li><a href="/#faq" class="hover:text-branding transition-colors">Häufige Fragen</a></li>
          <li><a href="/#kontakt" class="hover:text-branding transition-colors">Kontakt &amp; Anfahrt</a></li>
        </ul>
      </div>

      <!-- Contact Column -->
      <div class="md:col-span-4 space-y-4">
        <p class="text-[11px] uppercase tracking-editorial text-branding">Salon &amp; Kontakt</p>
        <div class="space-y-2.5 text-sm text-cream/75 font-light">
          <p>{SALON.address.street}, {SALON.address.postalCode} {SALON.address.city}</p>
          <p>
            <a href={SALON.phoneHref} class="text-cream hover:text-branding transition-colors font-normal">
              Tel. {SALON.phoneDisplay}
            </a>
          </p>
          <p>
            <a href={`mailto:${SALON.email}`} class="hover:text-branding transition-colors">
              {SALON.email}
            </a>
          </p>
          <p class="text-xs text-cream/55 pt-1">Di–Fr 09:00–18:00 · Sa 09:00–14:00</p>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Row -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-cream/50">
      <p>© {new Date().getFullYear()} {SALON.name}. Alle Rechte vorbehalten.</p>
      <div class="flex items-center gap-6">
        <a href={SALON.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-branding transition-colors">
          Instagram
        </a>
        <a href="/Impressum" class="hover:text-branding transition-colors">Impressum</a>
        <a href="/Datenschutz" class="hover:text-branding transition-colors">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>

<!-- Sticky Mobile Action Bar -->
<div
  class="fixed bottom-4 left-4 right-4 z-40 md:hidden"
  aria-label="Schnellaktionen"
>
  <div class="bg-espresso/95 backdrop-blur-md border border-white/15 rounded-full p-1.5 shadow-2xl grid grid-cols-2 gap-1.5">
    <a
      href={SALON.phoneHref}
      class="flex items-center justify-center gap-2 bg-branding text-espresso py-3 rounded-full text-xs uppercase tracking-[0.12em] font-semibold"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span>Anrufen</span>
    </a>
    <a
      href={SALON.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 text-cream py-3 rounded-full text-xs uppercase tracking-[0.12em] font-medium hover:text-branding transition-colors"
    >
      <svg class="w-4 h-4 text-branding" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span>Route</span>
    </a>
  </div>
</div>
